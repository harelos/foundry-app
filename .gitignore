# Foundry — files that must never leave your machine

# User data & session state
data.json
data.json.bak
templates.json

# Legacy private-build state files are never shipped
reel-data.json
reel-data.json.bak

# Local tooling config (preview launch config, permissions, etc.)
.claude/

# Uploads land inside project folders
mc-uploads/

# Node & OS
node_modules/
dist/
*.log
*.tmp
.env
.env.local

# IDE
.idea/
.vscode/
*.swp

# Mac / Windows junk
.DS_Store
Thumbs.db
desktop.ini

# Credentials backups (from account switcher)
credentials-backups/
*.credentials.json

# Per-account Claude login profiles (also live outside the repo, in ~/.foundry-accounts)
.foundry-accounts/
